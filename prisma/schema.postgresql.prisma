generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  username      String              @unique
  passwordHash  String
  role          String              @default("USER")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      Session[]
  memberships   DomainMembership[]
  domainsCreated Domain[]           @relation("DomainCreatedBy")
}

model Domain {
  id           String             @id @default(cuid())
  hostname     String             @unique
  name         String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdById  String?
  createdBy    User?              @relation("DomainCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships  DomainMembership[]
  @@index([active])
}

model DomainMembership {
  id        String   @id @default(cuid())
  domainId  String
  userId    String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([domainId, userId])
  @@index([userId])
  @@index([domainId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ShortLink {
  id                    String   @id @default(cuid())
  code                  String   @unique
  codeType              String
  targetUrl             String
  title                 String?
  description           String?
  canonicalUrl          String?
  imageUrl              String?
  faviconUrl            String?
  screenshotPath        String?
  metadataSource        String?
  contentHash           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastCheckedAt         DateTime?
  lastSuccessfulFetchAt DateTime?
  expiresAt             DateTime?
  clickCount            Int      @default(0)
  lastClickedAt         DateTime?
  active                Boolean  @default(true)
  jobs                  Job[]

  @@index([expiresAt])
  @@index([active])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  shortLinkId String
  status      String    @default("pending")
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([shortLinkId])
}
