generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  username        String              @unique
  passwordHash    String
  role            String              @default("USER")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        Session[]
  links           ShortLink[]
  collections     Collection[]
  memberships     DomainMembership[]
  domainsCreated  Domain[]            @relation("DomainCreatedBy")
}

model Domain {
  id           String             @id @default(cuid())
  hostname     String             @unique
  name         String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdById  String?
  createdBy    User?              @relation("DomainCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships  DomainMembership[]
  links        ShortLink[]
  @@index([active])
}

model DomainMembership {
  id        String   @id @default(cuid())
  domainId  String
  userId    String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([domainId, userId])
  @@index([userId])
  @@index([domainId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ShortLink {
  id                    String   @id @default(cuid())
  domainId              String
  code                  String
  codeType              String
  targetUrl             String
  ownerId               String?
  isPrivate             Boolean  @default(true)
  title                 String?
  description           String?
  canonicalUrl          String?
  imageUrl              String?
  faviconUrl            String?
  screenshotPath        String?
  metadataSource        String?
  contentHash           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastCheckedAt         DateTime?
  lastSuccessfulFetchAt DateTime?
  expiresAt             DateTime?
  clickCount            Int      @default(0)
  lastClickedAt         DateTime?
  active                Boolean  @default(true)
  domain                Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner                 User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  jobs                  Job[]

  @@unique([domainId, code])
  @@index([domainId])
  @@index([domainId, ownerId])
  @@index([expiresAt])
  @@index([active])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@unique([ownerId, name])
  @@index([ownerId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  shortLinkId String
  status      String    @default("pending")
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([shortLinkId])
}
