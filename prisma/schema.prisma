generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  username        String              @unique
  passwordHash    String
  role            String              @default("USER")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        Session[]
  links           ShortLink[]
  collections     Collection[]
  memberships     DomainMembership[]
  domainsCreated  Domain[]            @relation("DomainCreatedBy")
  apiKeys         ApiKey[]
  auditSalt       UserAuditSalt?
}

model Domain {
  id           String             @id @default(cuid())
  hostname     String             @unique
  name         String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdById  String?
  createdBy    User?              @relation("DomainCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships  DomainMembership[]
  links        ShortLink[]
  aliases      DomainAlias[]
  collections  Collection[]
  settings     DomainSetting?
  apiKeys      ApiKey[]
  auditLogEntries AuditLogEntry[]
  @@index([active])
}

model DomainAlias {
  id        String   @id @default(cuid())
  domainId  String
  hostname  String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@index([domainId])
  @@index([active])
}

model DomainMembership {
  id        String   @id @default(cuid())
  domainId  String
  userId    String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([domainId, userId])
  @@index([userId])
  @@index([domainId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([resetAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  domainId   String
  userId     String
  label      String
  keyPrefix  String    @unique
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  domain     Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([domainId])
  @@index([userId])
}

model ApiRequestAttempt {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}

/// Per-user secret used to pseudonymize audit log entries. Deleting the User cascades this
/// away, permanently and irreversibly severing the link between that user's historical audit
/// entries and their identity (crypto-shredding) without touching anyone else's history.
model UserAuditSalt {
  userId    String   @id
  salt      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Never stores a raw userId. `actorPseudonym` is HMAC(AUDIT_HASH_SECRET, userSalt + userId) —
/// deterministic per user while their account exists, permanently unrecoverable once it doesn't.
/// `apiKeyPseudonym` (set only when authMethod is "api_key") is HMAC(AUDIT_HASH_SECRET, apiKeyId)
/// — lets entries from the same key be correlated, and lets the key's own owner resolve it back
/// to a label client-side, without anyone else being able to join it to an identity via the
/// ApiKey table directly.
model AuditLogEntry {
  id               String   @id @default(cuid())
  domainId         String
  action           String
  resourceType     String?
  resourceId       String?
  actorPseudonym   String
  apiKeyPseudonym  String?
  authMethod       String
  createdAt        DateTime @default(now())
  domain           Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@index([domainId, createdAt])
  @@index([actorPseudonym])
  @@index([apiKeyPseudonym])
  @@index([createdAt])
}

model ShortLink {
  id String @id @default(cuid())
  domainId String
  code String
  codeType String
  targetUrl String
  ownerId String
  isPrivate Boolean @default(true)
  title String?
  description String?
  canonicalUrl String?
  imageUrl String?
  faviconUrl String?
  screenshotPath String?
  metadataSource String?
  contentHash String?
  etag String?
  lastModified String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  lastSuccessfulFetchAt DateTime?
  lastRenderedAt DateTime?
  renderStatus String @default("none")
  renderError String?
  needsRender Boolean @default(false)
  expiresAt DateTime?
  clickCount Int @default(0)
  lastClickedAt DateTime?
  active Boolean @default(true)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs Job[]
  visits LinkVisit[]
  dailyStats LinkDailyStat[]
  monthlyStats LinkMonthlyStat[]
  collections LinkCollection[]
  @@unique([domainId, code])
  @@index([domainId])
  @@index([domainId, ownerId])
  @@index([ownerId])
  @@index([isPrivate])
  @@index([expiresAt])
  @@index([active])
  @@index([needsRender, active, expiresAt])
}

model Collection {
  id String @id @default(cuid())
  domainId String
  name String
  description String?
  ownerId String
  isPrivate Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  links LinkCollection[]
  @@unique([domainId, name])
  @@index([domainId])
  @@index([domainId, ownerId])
  @@index([ownerId])
  @@index([isPrivate])
}

model LinkCollection {
  shortLinkId String
  collectionId String
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([shortLinkId, collectionId])
  @@index([collectionId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DomainSetting {
  id        String   @id @default(cuid())
  domainId  String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model Job {
  id String @id @default(cuid())
  type String
  shortLinkId String
  status String @default("pending")
  attempts Int @default(0)
  runAfter DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@index([status, runAfter])
  @@index([shortLinkId])
}

model LinkVisit {
  id String @id @default(cuid())
  shortLinkId String
  eventType String
  visitorHash String
  createdAt DateTime @default(now())
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@index([shortLinkId, createdAt])
  @@index([createdAt])
}

model LinkDailyStat {
  id String @id @default(cuid())
  shortLinkId String
  date DateTime
  pageViews Int @default(0)
  redirects Int @default(0)
  uniqueViews Int @default(0)
  uniqueRedirects Int @default(0)
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@unique([shortLinkId, date])
  @@index([shortLinkId, date])
}

model LinkMonthlyStat {
  id String @id @default(cuid())
  shortLinkId String
  year Int
  month Int
  uniqueViewsHll String
  uniqueRedirectsHll String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  @@unique([shortLinkId, year, month])
  @@index([shortLinkId, year, month])
}
