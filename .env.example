DATABASE_URL="file:./dev.db"
PUBLIC_URL="http://localhost:3000"
SCREENSHOT_DIR="./data/screenshots"
METADATA_REFRESH_HOURS="24"
FETCH_TIMEOUT_MS="15000"
FETCH_MAX_BYTES="5242880"

# Required: HMAC secret used to hash visitor IP/user-agent pairs for analytics.
ANALYTICS_HASH_SECRET="replace-with-a-long-random-secret"

# Required: bearer token the worker uses to call the internal /api/worker/* endpoints.
WORKER_SECRET="replace-with-a-long-random-secret"
