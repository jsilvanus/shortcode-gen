DATABASE_URL="file:./dev.db"
PUBLIC_URL="http://localhost:3000"
SCREENSHOT_DIR="./data/screenshots"
METADATA_REFRESH_HOURS="24"
FETCH_TIMEOUT_MS="15000"
FETCH_MAX_BYTES="5242880"

# Required: HMAC secret used to hash visitor IP/user-agent pairs for analytics.
ANALYTICS_HASH_SECRET="replace-with-a-long-random-secret"

# Required: bearer token the worker uses to call the internal /api/worker/* endpoints.
WORKER_SECRET="replace-with-a-long-random-secret"

# Number of trusted reverse proxy hops in front of this app (Nginx in staging, Traefik in
# production count as one hop each). Used to pick the real client IP out of X-Forwarded-For
# for rate limiting, ignoring any client-forged entries in front of it. This is a deployment
# topology fact, not a per-domain setting — it is intentionally environment-only and not
# exposed anywhere in the admin UI. Defaults to 1 if unset.
TRUSTED_PROXY_HOPS="1"
